@startuml c4_nivel3_componentes_worker
!pragma layout elk
!include <C4/C4_Component>

' Estilo: colores del machote C4 del proyecto
HIDE_STEREOTYPE()
LAYOUT_TOP_DOWN()
skinparam dpi 180
skinparam wrapWidth 190
skinparam maxMessageSize 100
skinparam titleFontSize 22
skinparam noteBorderColor #ADB5BD
skinparam noteTextAlignment left
skinparam legendBackgroundColor #FFFFFF
skinparam legendBorderColor #CED4DA
skinparam legendFontColor #212529
skinparam legendFontSize 13
UpdateElementStyle("person", $bgColor="#A5D8FF", $fontColor="#1864AB", $borderColor="#1971C2")
UpdateElementStyle("system", $bgColor="#D0BFFF", $fontColor="#5F3DC4", $borderColor="#7048E8")
UpdateElementStyle("external_system", $bgColor="#E9ECEF", $fontColor="#495057", $borderColor="#868E96")
UpdateElementStyle("container", $bgColor="#D0BFFF", $fontColor="#5F3DC4", $borderColor="#7048E8")
UpdateElementStyle("external_container", $bgColor="#E9ECEF", $fontColor="#495057", $borderColor="#868E96")
UpdateElementStyle("component", $bgColor="#D0BFFF", $fontColor="#5F3DC4", $borderColor="#7048E8")
AddElementTag("bd", $bgColor="#C5F6FA", $fontColor="#0B7285", $borderColor="#0C8599")
AddElementTag("infra", $bgColor="#C3FAE8", $fontColor="#087F5B", $borderColor="#099268")
UpdateRelStyle($textColor="#343A40", $lineColor="#495057")

title Nivel 3 · Diagrama de Componentes — Worker de procesamiento (ServIA)

legend top left
|= Leyenda |<#D0BFFF>      | Componente del contenedor |<#C3FAE8>      | Componente de infraestructura compartida |<#C5F6FA>      | Base de datos o almacenamiento |<#E9ECEF>      | Contenedor fuera de foco o sistema externo |<#F1F3F5>      | Nota aclaratoria |
La flecha sale del elemento que inicia la interacción; entre corchetes, la tecnología o el protocolo.
endlegend

Container_Ext(api, "API Backend", "Contenedor: FastAPI · Python", "")
ContainerDb(redis, "Almacén en memoria", "Contenedor: Redis 7", "", $tags="bd")

rectangle "== <color:#6741D9>Contenedor: Worker de procesamiento</color>\n<size:12><color:#6741D9>[Celery · Python]</color></size>" <<boundary>> as worker #F8F6FF;line:9775FA;line.dashed {
  Component(tarea, "Tarea de procesamiento", "Componente: procesar_archivo_celery", "Un archivo por tarea; evita duplicados, atiende la cancelación y limita la duración.")
  Component(progreso, "Seguimiento del progreso", "Componente: progress_tracker", "Publica el porcentaje y el estado de cada tarea.")
  Component(procesador, "Procesador de documentos", "Componente: document_processor", "Registra el documento, enruta la extracción por tipo y fija el estado final.")
  Component(extractor, "Cliente de extracción de texto", "Componente: tika_service", "Envía los documentos a Tika; los TXT se decodifican directamente.")
  Component(transcriptor, "Transcriptor de audio", "Componente: faster-whisper", "Transcribe el audio dentro del proceso, completo o por segmentos.")
  Component(clienteHtr, "Cliente de reconocimiento en imagen", "Componente: htr_service", "Envía la imagen al servidor de reconocimiento y recibe su texto.")
  Component(limpieza, "Limpieza de texto", "Componente: text_cleaner", "Normaliza Unicode y corrige la codificación.")
  Component(vectorizador, "Fragmentación e indexación", "Componente: storage · LangChain", "Fragmentos de 7000 caracteres (traslape de 500) con metadatos de tema y archivo.")
  rectangle "== <color:#087F5B>Núcleo compartido con la API Backend</color>\n<size:12><color:#087F5B>[mismo código, otro proceso]</color></size>" <<boundary>> as nucleo #EEFCF6;line:63E6BE;line.dashed {
    Component(embeddings, "Modelo de embeddings", "Componente: multilingual-e5-large", "Mismo modelo que usa la API Backend.", $tags="infra")
    Component(vector, "Adaptador vectorial", "Componente: VectorStoreBackend · Qdrant", "Inserta los fragmentos con sus vectores y metadatos.", $tags="infra")
    Component(datos, "Acceso a datos", "Componente: SQLAlchemy · repositorios", "Busca o crea el tema; crea el documento y actualiza su estado.", $tags="infra")
    Component(auditoria, "Auditoría de ingesta", "Componente: ingesta_audit_service", "Registra inicio, fin o error de cada archivo.", $tags="infra")
  }
}

Container_Ext(tika, "Servidor de extracción de texto", "Contenedor: Apache Tika · Tesseract OCR", "")
Container_Ext(htr, "Servidor de reconocimiento de texto en imagen", "Contenedor: FastAPI · docTR + TrOCR · GPU compartida", "")
ContainerDb(qdrant, "Base de datos vectorial", "Contenedor: Qdrant", "", $tags="bd")
ContainerDb(sql, "Base de datos relacional", "Contenedor: SQL Server 2022", "", $tags="bd")

Rel_R(api, redis, "Encola una tarea por archivo y consulta su progreso", "Celery · Redis")
Rel_U(tarea, redis, "Toma la tarea de la cola", "Celery · Redis")
Rel(tarea, progreso, "Crea el seguimiento y verifica la cancelación")
Rel(progreso, redis, "Publica el progreso", "Redis")
Rel(tarea, procesador, "Procesa el archivo")
Rel(tarea, auditoria, "Registra inicio, fin o error")
Rel(procesador, extractor, "Documentos de texto")
Rel(procesador, transcriptor, "Audio")
Rel(procesador, clienteHtr, "Imágenes")
Rel(procesador, limpieza, "Limpia el texto obtenido")
Rel(procesador, vectorizador, "Fragmenta e indexa")
Rel(procesador, datos, "Registra el documento y su estado")
Rel(vectorizador, embeddings, "Genera los vectores")
Rel(vectorizador, vector, "Inserta los fragmentos")
Rel(auditoria, datos, "Inserta registros")
Rel(extractor, tika, "Extrae el texto", "HTTP")
Rel(clienteHtr, htr, "Reconoce el texto", "HTTP · JSON")
Rel(vector, qdrant, "Inserta", "HTTP")
Rel(datos, sql, "Lee y escribe", "SQLAlchemy · ODBC")

note right of htr #F1F3F5
  <color:#343A40>Orientado a texto impreso o tipeado; la escritura a mano es una limitación aceptada (RF-10).</color>
end note

' Ubicación relativa de los elementos (no son relaciones)
Lay_D(extractor, tika)
Lay_D(clienteHtr, htr)
@enduml