@startuml
left to right direction

skinparam backgroundColor white
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #EAF1F8
  BorderColor #1F4E79
  FontColor #1F4E79
}
skinparam actor {
  BorderColor #1F4E79
  FontColor #1F4E79
}
skinparam rectangle {
  BorderColor #1F4E79
  FontColor #1F4E79
  FontStyle bold
}
skinparam ArrowColor #1F4E79
skinparam packageStyle rectangle

actor "Administrador" as ADM
rectangle "Sistema ServIA" {
  usecase "Consultar y Filtrar la Bitácora" as CU15
  usecase "Aplicar filtros combinados" as S1
  usecase "Ver detalle de un evento" as S2
  usecase "Exportar bitácora a PDF" as S3
  usecase "Ver Dashboard de Métricas\n(CU-16)" as RCU16
}
ADM --> CU15
CU15 ..> S1 : <<include>>
CU15 ..> S2 : <<extend>>
CU15 ..> S3 : <<extend>>
CU15 ..> RCU16 : <<extend>>
@enduml