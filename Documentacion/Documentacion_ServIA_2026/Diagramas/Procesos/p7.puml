@startuml
skinparam backgroundColor white
skinparam dpi 130
skinparam shadowing false
skinparam ArrowColor #1F4E79
skinparam activity {
  BackgroundColor #EAF1F8
  BorderColor #1F4E79
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #1F4E79
}
skinparam swimlane {
  BorderColor #1F4E79
  TitleFontColor #1F4E79
  TitleFontSize 15
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #B7791F
}
title P7 - Administración de Cuentas de Usuario
|Administrador|
start
:Abrir "Usuarios del Sistema"\ny buscar la cuenta;
if (¿Crear una cuenta?) then (sí)
  |Administrador|
  :Completar cédula, nombre,\napellidos, correo y rol;
  |Sistema|
  if (¿Datos válidos?) then (no)
    :Señalar el campo con error;
    stop
  else (sí)
  endif
  :Crear la cuenta con una contraseña\ntemporal de 8 caracteres;
  |Servicio de correo|
  :Enviar la contraseña temporal\nal usuario;
  |Sistema|
  if (¿Envío exitoso?) then (no)
    :Informar al Administrador que no se entregó\n(la cuenta ya está creada);
  else (sí)
  endif
elseif (¿Restablecer la contraseña?) then (sí)
  |Sistema|
  :Generar una nueva contraseña temporal;
  |Servicio de correo|
  :Enviar la contraseña temporal\nal usuario;
  |Sistema|
  if (¿Envío exitoso?) then (sí)
    :Guardar la contraseña y exigir su cambio\nen el próximo ingreso;
  else (no)
    :No modificar la contraseña e informar\nal Administrador (puede reintentar);
  endif
else (editar o desactivar)
  |Administrador|
  :Modificar datos, rol o estado\n(Inactivo = desactivación lógica);
  |Sistema|
  :Guardar los cambios\ny registrar la operación;
  stop
endif
|Sistema|
:Registrar la operación en la bitácora\ncon el resultado del envío;
stop
@enduml
