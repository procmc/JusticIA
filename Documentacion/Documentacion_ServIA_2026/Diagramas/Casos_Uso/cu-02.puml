@startuml
left to right direction

skinparam backgroundColor white
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #EAF1F8
  BorderColor #1F4E79
  FontColor #1F4E79
}
skinparam actor {
  BorderColor #1F4E79
  FontColor #1F4E79
}
skinparam rectangle {
  BorderColor #1F4E79
  FontColor #1F4E79
  FontStyle bold
}
skinparam ArrowColor #1F4E79
skinparam packageStyle rectangle

actor "Usuario Gubernamental" as UG
actor "Administrador" as ADM
rectangle "Sistema ServIA" {
  usecase "Cerrar Sesión" as CU02
  usecase "Registrar evento en bitácora" as S1
  usecase "Expirar sesión por inactividad" as S2
}
UG --> CU02
ADM --> CU02
CU02 ..> S1 : <<include>>
CU02 ..> S2 : <<extend>>
@enduml