@startuml
left to right direction

skinparam backgroundColor white
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #EAF1F8
  BorderColor #1F4E79
  FontColor #1F4E79
}
skinparam actor {
  BorderColor #1F4E79
  FontColor #1F4E79
}
skinparam rectangle {
  BorderColor #1F4E79
  FontColor #1F4E79
  FontStyle bold
}
skinparam ArrowColor #1F4E79
skinparam packageStyle rectangle

actor "Usuario Gubernamental" as UG
actor "Administrador" as ADM
rectangle "Sistema ServIA" {
  usecase "Iniciar Sesión" as CU01
  usecase "Validar credenciales" as S1
  usecase "Registrar evento en bitácora" as S2
  usecase "Recuperar Contraseña\n(CU-04)" as RCU04
  usecase "Cambiar contraseña obligatoria" as S3
}
UG --> CU01
ADM --> CU01
CU01 ..> S1 : <<include>>
CU01 ..> S2 : <<include>>
CU01 ..> RCU04 : <<extend>>
CU01 ..> S3 : <<extend>>
@enduml