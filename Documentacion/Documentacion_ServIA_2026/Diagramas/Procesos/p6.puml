@startuml
skinparam backgroundColor white
skinparam dpi 130
skinparam shadowing false
skinparam ArrowColor #1F4E79
skinparam activity {
  BackgroundColor #EAF1F8
  BorderColor #1F4E79
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #1F4E79
}
skinparam swimlane {
  BorderColor #1F4E79
  TitleFontColor #1F4E79
  TitleFontSize 15
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #B7791F
}
title P6 - Recuperación, Cambio de Contraseña y Perfil
start
switch (¿Qué necesita el usuario?)
case (Olvidó su contraseña)
  :Indicar su correo registrado;
  if (¿El servicio de recuperación
está disponible?) then (no)
    :El sistema informa que no está
disponible y lo registra
en la bitácora;
    stop
  else (sí)
  endif
  :El sistema responde siempre
el mismo mensaje, exista o no
la cuenta;
  if (¿Cuenta Activa y dentro
del límite de solicitudes?) then (sí)
    :El sistema genera un código
de 6 dígitos (válido 15 minutos);
    :El servicio de correo envía
el código (después de responder);
  else (no)
    :No se envía ningún código;
  endif
  :El sistema registra el resultado
de la solicitud en la bitácora;
  :Ingresar el código recibido;
  if (¿Código correcto, vigente
y con intentos disponibles?) then (no)
    :El sistema lo indica (al quinto
intento fallido invalida el código)
y permite solicitar otro código;
    stop
  else (sí)
  endif
  if (¿La cuenta sigue Activa
y sin cambios?) then (no)
    :El sistema informa que el proceso
venció; debe iniciarlo de nuevo;
    stop
  else (sí)
  endif
  :Definir la nueva contraseña
(10 minutos; mínimo 8 caracteres);
case (Cambiar su contraseña)
  :Indicar la contraseña actual
y la nueva;
  if (¿Actual correcta
y nueva válida?) then (no)
    :El sistema indica el error;
    stop
  else (sí)
  endif
case (Cambiar su avatar)
  :Elegir un avatar o subir una foto
(JPG, PNG, GIF o WebP; máximo 5 MB);
  :El sistema muestra la vista previa;
  :Guardar el avatar;
  :El sistema lo actualiza
en toda la interfaz;
  stop
endswitch
:El sistema guarda la contraseña cifrada
y registra el cambio en la bitácora;
stop
@enduml
